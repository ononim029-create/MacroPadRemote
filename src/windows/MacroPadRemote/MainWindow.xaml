<Window x:Class="MacroPadRemote.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MacroPad Remote" Width="1500" Height="900" MinWidth="1100" MinHeight="700">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="*"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#1B1D20" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
   <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="180"/></Grid.RowDefinitions>
    <Grid><TextBlock Text="Профили" FontSize="20" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="+" Width="36" Click="AddProfile_Click"/><Button Content="−" Width="36" Margin="6,0,0,0" Click="DeleteProfile_Click"/></StackPanel></Grid>
    <ListBox x:Name="ProfilesList" Grid.Row="1" Margin="0,14,0,12" Background="Transparent" BorderThickness="0" SelectionChanged="ProfilesList_SelectionChanged">
     <ListBox.ItemTemplate><DataTemplate><Grid Height="52"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions><Border Width="34" Height="34" Background="#24282C" BorderBrush="#40464C" BorderThickness="1"><TextBlock Text="{Binding Icon}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border><TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="10,0"/><Button Grid.Column="2" Content="⋮" Tag="{Binding}" Click="ProfileMenu_Click"/></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Grid.Row="2" Text="Устройства" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,10"/>
    <Border Grid.Row="3" Background="#202326" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="12"><StackPanel><TextBlock Text="Телефон" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="DeviceText" Text="Нет подключенных устройств" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/><TextBlock x:Name="AddressText" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/><Button Content="Запустить / остановить связь" Margin="0,14,0,0" Click="ToggleServer_Click"/><TextBlock x:Name="PairCodeText" FontSize="20" FontWeight="Bold" Margin="0,10,0,0"/></StackPanel></Border>
   </Grid>
  </Border>

  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/><RowDefinition Height="255"/></Grid.RowDefinitions>
   <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="28,18"><Grid><StackPanel><TextBlock x:Name="ProfileTitle" Text="Профиль" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="PageInfo" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><TextBlock x:Name="StatusText" Text="● Отключено" VerticalAlignment="Center" Margin="0,0,14,0"/><Button Content="Сохранить" Click="Save_Click"/></StackPanel></Grid></Border>
   <ScrollViewer Grid.Row="1" Margin="28,24"><Grid x:Name="DeckGrid" HorizontalAlignment="Center" VerticalAlignment="Top"/></ScrollViewer>
   <Border Grid.Row="2" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="24,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,22,0"><TextBlock Text="Свойства профиля" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Название" Foreground="{StaticResource Muted}" Margin="0,14,0,4"/><TextBox x:Name="ProfileNameBox"/><TextBlock Text="Описание" Foreground="{StaticResource Muted}" Margin="0,12,0,4"/><TextBox x:Name="DescriptionBox" Height="70" AcceptsReturn="True"/></StackPanel>
    <StackPanel Grid.Column="1" Margin="0,0,22,0"><TextBlock Text="Сетка макропада" FontSize="18" FontWeight="SemiBold"/><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Столбцы" Foreground="{StaticResource Muted}"/><TextBox x:Name="ColumnsBox" Text="4" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Строки" Foreground="{StaticResource Muted}"/><TextBox x:Name="RowsBox" Text="3" Margin="0,4,0,0"/></StackPanel></Grid><TextBlock Text="Размер отдельных ячеек: ПКМ по плитке" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,18,0,0"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Дополнительные функции" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="ShowNumbersBox" Content="Показывать номера клавиш" IsChecked="True" Margin="0,14,0,0"/><CheckBox x:Name="ShowLabelsBox" Content="Показывать подписи" IsChecked="True" Margin="0,9,0,0"/><CheckBox Content="Длинное нажатие" IsChecked="True" Margin="0,9,0,0"/><CheckBox Content="Виброотклик на телефоне" Margin="0,9,0,0"/></StackPanel>
   </Grid></Border>
  </Grid>

  <Border Grid.Column="2" Background="#1B1D20" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBox x:Name="ActionSearchBox" Height="38" Text="" ToolTip="Поиск действий..."/><Grid Grid.Row="1" Margin="0,10,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="Клавиша" Click="ActionsKey_Click"/><Button Grid.Column="1" Content="Информационная" Margin="6,0,0,0" Click="ActionsInfo_Click"/></Grid><ListBox x:Name="ActionsList" Grid.Row="2" Background="Transparent" BorderThickness="0" MouseDoubleClick="ActionsList_DoubleClick"/></Grid></Border>
 </Grid>
</Window>
