<Window x:Class="MacroPadRemote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacroPad Remote" Width="1680" Height="960" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="250"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="285"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#1B1D1F" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0,14,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="▦" FontSize="23" FontWeight="Bold" Margin="0,0,10,0"/>
                    <TextBlock Text="MacroPad Remote" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="  v0.5.1 preview" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#202326" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="10,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="●" x:Name="HeaderDot" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,0,6,0"/><TextBlock x:Name="HeaderStatus" Text="Нет подключенных телефонов" FontSize="12"/></StackPanel>
                    </Border>
                    <Button x:Name="HeaderQrButton" Content="QR" Width="42" Height="30" Margin="0,0,6,0" Click="ShowQr_Click"/>
                    <Button x:Name="HeaderServerButton" Content="Запустить связь" Height="30" Click="ServerButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Background="#1B1D1F" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="1"/><RowDefinition Height="260"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="50"/></Grid.RowDefinitions>
                    <Grid Margin="18,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Профили" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Content="＋" Width="34" Height="30" Click="AddProfile_Click"/></Grid>
                    <ListBox x:Name="ProfileBox" Grid.Row="1" Margin="7,2,7,0" SelectionChanged="ProfileBox_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="55">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" Background="#111315" BorderBrush="#41464A" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="{Binding Icon}" FontSize="17" FontWeight="Bold" Foreground="#69AFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Button x:Name="ProfileDots" Grid.Column="2" Content="⋮" FontSize="20" Background="Transparent" BorderThickness="0" Visibility="Hidden" Tag="{Binding}" Click="ProfileMenu_Click"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}},Path=IsMouseOver}" Value="True"><Setter TargetName="ProfileDots" Property="Visibility" Value="Visible"/></DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}},Path=IsSelected}" Value="True"><Setter TargetName="ProfileDots" Property="Visibility" Value="Visible"/></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="2" Margin="12,5,12,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions><Button Content="＋  Добавить профиль" HorizontalContentAlignment="Left" Click="AddProfile_Click"/><Button Grid.Column="1" Content="−" Margin="6,0,0,0" Click="DeleteProfile_Click"/></Grid>
                </Grid>
                <Border Grid.Row="1" Background="{StaticResource Border}"/>
                <Grid Grid.Row="2" Margin="12,10,12,12">
                    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Устройства" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Grid.Row="1" Background="#202326" BorderBrush="#44494D" BorderThickness="1" Padding="11" Margin="0,5,0,0">
                        <StackPanel>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="28" Height="42" BorderBrush="#BFC4C8" BorderThickness="2"><TextBlock Text="•" HorizontalAlignment="Center" VerticalAlignment="Bottom"/></Border><StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"><TextBlock Text="Телефон" FontWeight="SemiBold"/><TextBlock x:Name="DeviceStatus" Text="Связь не запущена" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/></StackPanel></Grid>
                            <TextBlock Text="Способ подключения" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,4"/>
                            <ComboBox x:Name="TransportBox" Height="34" SelectionChanged="TransportBox_SelectionChanged"><ComboBoxItem Content="Wi‑Fi" Tag="Wifi"/><ComboBoxItem Content="Bluetooth" Tag="Bluetooth"/></ComboBox>
                            <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions><Button x:Name="DeviceServerButton" Content="Запустить связь" Click="ServerButton_Click" Margin="0,0,7,0"/><Button x:Name="DeviceQrButton" Grid.Column="1" Content="QR-код" Click="ShowQr_Click"/></Grid>
                            <TextBlock x:Name="ConnectionDetails" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Background="{StaticResource Bg}">
            <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions>
            <Grid Margin="28,16,24,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><TextBlock x:Name="ProfileTitle" Text="Revit" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="  ✎" FontSize="18" Foreground="{StaticResource Muted}"/></StackPanel><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock x:Name="GridInfo" Text="12 ячеек" Foreground="{StaticResource Muted}"/><TextBlock Text="  •  " Foreground="{StaticResource Muted}"/><TextBlock x:Name="PageInfo" Text="Страница 1 из 1" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ComboBox x:Name="PageBox" Width="170" DisplayMemberPath="Name" SelectionChanged="PageBox_SelectionChanged"/><Button Content="＋" Width="38" Margin="7,0,0,0" Click="AddPage_Click"/></StackPanel>
            </Grid>
            <Border Grid.Row="1" Margin="24,0" Background="#141618" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <ScrollViewer x:Name="DeckViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="24" PreviewMouseWheel="DeckViewport_PreviewMouseWheel" SizeChanged="DeckViewport_SizeChanged">
                    <Grid x:Name="DeckScaleHost" HorizontalAlignment="Center" VerticalAlignment="Top"><Grid x:Name="DeckGrid"/></Grid>
                </ScrollViewer>
            </Border>
            <Grid Grid.Row="2" Margin="20,5"><StackPanel x:Name="PageButtons" Orientation="Horizontal" HorizontalAlignment="Center"/></Grid>
        </Grid>

        <Border Grid.Row="2" Grid.Column="1" Background="#191B1D" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Grid Margin="20,12"><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Свойства профиля" FontSize="15" FontWeight="SemiBold"/>
                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,16,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="34"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Название" Foreground="{StaticResource Muted}" FontSize="11"/><TextBox x:Name="ProfileName" Grid.Row="1"/><TextBlock Grid.Row="2" Text="Описание" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,3"/><TextBox x:Name="ProfileDescription" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap"/></Grid>
                    <Border Grid.Column="1" Background="{StaticResource Border}"/>
                    <Grid Grid.Column="2" Margin="16,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="58"/><RowDefinition Height="Auto"/><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Сетка макропада" FontWeight="SemiBold" FontSize="12"/><Grid Grid.Row="1" Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Столбцы" Foreground="{StaticResource Muted}" FontSize="11"/><TextBox x:Name="ColumnsBox" Height="32"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Строки" Foreground="{StaticResource Muted}" FontSize="11"/><TextBox x:Name="RowsBox" Height="32"/></StackPanel></Grid><TextBlock Grid.Row="2" Text="Масштаб" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,2"/><Slider x:Name="ZoomSlider" Grid.Row="3" Minimum="0.55" Maximum="2.5" Value="1" ValueChanged="ZoomSlider_ValueChanged"/><TextBlock Grid.Row="4" Text="Ctrl + колесо — приблизить/отдалить. Двойной клик по плитке — приблизить её. ПКМ — размер ячейки." Foreground="#89BFEF" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/></Grid>
                    <Border Grid.Column="3" Background="{StaticResource Border}"/>
                    <Grid Grid.Column="4" Margin="16,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="38"/></Grid.RowDefinitions><TextBlock Text="Дополнительные функции" FontWeight="SemiBold" FontSize="12"/><StackPanel Grid.Row="1" Margin="0,6,0,0"><CheckBox x:Name="ShowNumbers" Content="Показывать номера клавиш" IsChecked="True"/><CheckBox x:Name="ShowLabels" Content="Показывать подписи" IsChecked="True" Margin="0,4,0,0"/><CheckBox Content="Виброотклик на телефоне" IsChecked="True" Margin="0,4,0,0"/><CheckBox Content="Длинное нажатие" IsChecked="True" Margin="0,4,0,0"/></StackPanel><Button Grid.Row="2" Content="Сохранить" HorizontalAlignment="Right" Width="118" Click="SaveProfile_Click"/></Grid>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Background="#1B1D1F" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0">
            <Grid><Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition/></Grid.RowDefinitions><TextBox Margin="14,12" Height="34" VerticalContentAlignment="Center" ToolTip="Поиск действий"/>
                <TabControl Grid.Row="1">
                    <TabItem Header="Клавиша"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <Expander Header="▦   MacroPad Remote" IsExpanded="True" Padding="14,12" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"><ListBox x:Name="ActionsList" MouseDoubleClick="ActionsList_DoubleClick" Background="Transparent" BorderThickness="0"/></Expander>
                        <Expander Header="🔧   Набор инструментов" Padding="14,12" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"><StackPanel Margin="18,6"><TextBlock Text="Запустить программу" Margin="0,4"/><TextBlock Text="Открыть файл / папку" Margin="0,4"/><TextBlock Text="Ввести текст" Margin="0,4"/></StackPanel></Expander>
                        <Expander Header="🔊   Аудиоплеер" Padding="14,12" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"><StackPanel Margin="18,6"><TextBlock Text="Play / Pause"/><TextBlock Text="Громкость + / −" Margin="0,6"/><TextBlock Text="Mute"/></StackPanel></Expander>
                        <Expander Header="⌘   Операционный поток" Padding="14,12" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"/>
                        <Expander Header="◉   Студия OBS" Padding="14,12" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"/>
                        <Expander Header="▣   Calendar                                      NEW" Padding="14,12" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"/>
                        <Expander Header="◷   DateTime                                      NEW" Padding="14,12" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"/>
                        <Expander Header="▤   Полезные примечания                         NEW" Padding="14,12" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"/>
                        <Expander Header="⌨   Системные команды" Padding="14,12" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"/>
                        <Expander Header="▣   Управление окнами" Padding="14,12" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"/>
                        <Expander Header="◎   Сеть и интернет" Padding="14,12" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"/>
                        <Expander Header="▰   Файлы и папки" Padding="14,12" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"/>
                    </StackPanel></ScrollViewer></TabItem>
                    <TabItem Header="Информационная"><StackPanel Margin="14"><TextBlock Text="Информационные плитки" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"/><Button Content="Дата и время" Margin="0,0,0,7"/><Button Content="Статус подключения" Margin="0,0,0,7"/><Button Content="Текст / заметка" Margin="0,0,0,7"/><Button Content="Системная информация"/></StackPanel></TabItem>
                </TabControl>
            </Grid>
        </Border>
    </Grid>
</Window>
