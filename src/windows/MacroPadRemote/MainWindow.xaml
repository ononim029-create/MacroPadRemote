<Window x:Class="MacroPadRemote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="NEXO" Width="1680" Height="960" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="250"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="285"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="385"/>
        </Grid.ColumnDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Background="#1B1D1F" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0,14,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="▦" FontSize="23" FontWeight="Bold" Margin="0,0,10,0"/>
                    <TextBlock Text="NEXO" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="  v0.10 preview" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#202326" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="10,5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="●" x:Name="HeaderDot" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,0,6,0"/>
                            <TextBlock x:Name="HeaderStatus" Text="Поиск устройств…" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="HeaderSettingsButton" Content="⚙" Width="38" Height="30" Margin="0,0,6,0" Click="HeaderSettingsButton_Click" ToolTip="Подключение и устройства"/>
                    <Button x:Name="HeaderQrButton" Content="QR" Width="42" Height="30" Margin="0,0,6,0" Click="ShowQr_Click" ToolTip="Показать QR для подключения"/>
                    <Button x:Name="HeaderServerButton" Content="Связь активна" Height="30" Click="ServerButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Left: profiles + devices -->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="0" Background="#1B1D1F" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="0"/><RowDefinition Height="0"/></Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="50"/></Grid.RowDefinitions>
                    <Grid Margin="18,0,12,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Профили" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="＋" Width="34" Height="30" Click="AddProfile_Click"/>
                    </Grid>
                    <ListBox x:Name="ProfileBox" Grid.Row="1" Margin="7,2,7,0" SelectionChanged="ProfileBox_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="55">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" Background="#111315" BorderBrush="#41464A" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" FontSize="17" FontWeight="Bold" Foreground="#69AFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <Button x:Name="ProfileDots" Grid.Column="2" Content="⋮" FontSize="20" Background="Transparent" BorderThickness="0" Visibility="Hidden" Tag="{Binding}" Click="ProfileMenu_Click"/>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}},Path=IsMouseOver}" Value="True"><Setter TargetName="ProfileDots" Property="Visibility" Value="Visible"/></DataTrigger>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBoxItem}},Path=IsSelected}" Value="True"><Setter TargetName="ProfileDots" Property="Visibility" Value="Visible"/></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="2" Margin="12,5,12,8">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <Button Content="＋  Добавить профиль" HorizontalContentAlignment="Left" Click="AddProfile_Click"/>
                        <Button Grid.Column="1" Content="−" Margin="6,0,0,0" Click="DeleteProfile_Click"/>
                    </Grid>
                </Grid>
                <Border Grid.Row="1" Background="{StaticResource Border}"/>
                <Grid Grid.Row="2" Margin="12,10,12,12" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="92"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Устройства" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="QR" Width="42" Height="28" Click="ShowQr_Click" ToolTip="Привязать новое устройство"/>
                    </Grid>
                    <Border Grid.Row="1" Background="#202326" BorderBrush="#44494D" BorderThickness="1" Padding="10" Margin="0,5,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Width="28" Height="42" BorderBrush="#BFC4C8" BorderThickness="2"><TextBlock Text="•" HorizontalAlignment="Center" VerticalAlignment="Bottom"/></Border>
                            <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ConnectionModeText" Text="Wi‑Fi" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DeviceStatus" Text="Поиск в локальной сети" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ConnectionDetails" Foreground="#86BFEF" FontSize="9" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="2" Text="Привязанные" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,2,0,4"/>
                    <ListBox x:Name="TrustedDevicesList" Grid.Row="3" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="46" Margin="2,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DeviceGlyph}" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,0,0">
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Details}" Foreground="{StaticResource Muted}" FontSize="9" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="⋮" FontSize="18" Padding="0" Background="Transparent" BorderThickness="0" Tag="{Binding}" Click="TrustedDeviceMenu_Click" ToolTip="Меню устройства"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="4" Text="⋮ рядом с устройством — забыть и потребовать новую привязку по QR" Foreground="{StaticResource Muted}" FontSize="9" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Center deck -->
        <Grid Grid.Row="1" Grid.Column="1" Background="{StaticResource Bg}">
            <Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/><RowDefinition Height="52"/></Grid.RowDefinitions>
            <Grid Margin="28,16,24,8">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="ProfileTitle" Text="Revit" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="  ✎" FontSize="18" Foreground="{StaticResource Muted}"/></StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock x:Name="GridInfo" Text="12 ячеек" Foreground="{StaticResource Muted}"/><TextBlock Text="  •  " Foreground="{StaticResource Muted}"/><TextBlock x:Name="PageInfo" Text="Страница 1 из 1" Foreground="{StaticResource Muted}"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ComboBox x:Name="PageBox" Width="1" Height="1" Visibility="Collapsed" DisplayMemberPath="Name" SelectionChanged="PageBox_SelectionChanged"/><Button x:Name="ProfileSettingsButton" Content="⚙" Width="38" Height="32" Click="ProfileSettingsButton_Click" ToolTip="Свойства профиля"/></StackPanel>
            </Grid>
            <Border Grid.Row="1" Margin="24,0" Background="#141618" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <ScrollViewer x:Name="DeckViewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="24" PreviewMouseWheel="DeckViewport_PreviewMouseWheel" SizeChanged="DeckViewport_SizeChanged">
                    <Grid x:Name="DeckScaleHost" HorizontalAlignment="Center" VerticalAlignment="Top"><Grid x:Name="DeckGrid"/></Grid>
                </ScrollViewer>
            </Border>
            <Grid Grid.Row="2" Margin="20,5"><StackPanel x:Name="PageButtons" Orientation="Horizontal" HorizontalAlignment="Center"/></Grid>
        </Grid>

        <!-- Bottom: selected action properties -->
        <Border Grid.Row="2" Grid.Column="1" Background="#191B1D" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Grid Margin="20,10">
                <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Свойства действия" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="InspectorHint" Grid.Column="1" Text="Выберите плитку или перетащите действие на рабочее поле." Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Название" Foreground="{StaticResource Muted}" FontSize="10"/><TextBox x:Name="InspectorTitleBox" Height="30" Margin="0,3,0,6" TextChanged="InspectorChanged"/>
                        <CheckBox x:Name="InspectorShowLabel" Content="Показывать название на клавише" IsChecked="True" FontSize="10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Тип действия" Foreground="{StaticResource Muted}" FontSize="10"/><TextBox x:Name="InspectorTypeBox" Height="30" Margin="0,3,0,6" IsReadOnly="True"/>
                        <TextBlock x:Name="InspectorValueLabel" Text="Параметр" Foreground="{StaticResource Muted}" FontSize="10"/><TextBox x:Name="InspectorValueBox" Height="30" Margin="0,3,0,0" TextChanged="InspectorChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Горячая клавиша" Foreground="{StaticResource Muted}" FontSize="10"/>
                        <Grid Margin="0,3,0,7"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions><TextBox x:Name="InspectorHotkeyBox" Height="30" IsReadOnly="True"/><Button x:Name="RecordHotkeyButton" Grid.Column="1" Content="Записать" Margin="5,0,0,0" Click="RecordHotkey_Click" PreviewKeyDown="RecordHotkey_PreviewKeyDown"/></Grid>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><Border x:Name="InspectorIconPreview" Width="38" Height="38" Background="#111315" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="4"/><StackPanel Grid.Column="1" Margin="6,0"><TextBlock x:Name="InspectorIconStatus" Text="Автоматически" FontSize="9" TextWrapping="Wrap"/><Button x:Name="IconLibraryButton" Content="Библиотека…" Height="23" Margin="0,2,0,0" Click="IconLibrary_Click"/></StackPanel><StackPanel Grid.Column="2"><Button x:Name="IconImportButton" Content="Импорт" Height="23" Click="IconImport_Click"/><Button x:Name="IconScreenshotButton" Content="Снимок" Height="23" Margin="0,2,0,0" Click="IconScreenshot_Click"/></StackPanel></Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Иконка / действие" Foreground="{StaticResource Muted}" FontSize="10"/>
                        <Button x:Name="IconResetButton" Content="Авто-иконка" Height="28" Margin="0,4,0,6" Click="IconReset_Click"/>
                        <TextBlock Text="Плитки можно перетаскивать мышью и менять местами в пределах текущей сетки." Foreground="#89BFEF" FontSize="9" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Очистить" Width="78" Margin="0,0,6,0" Click="ClearTile_Click"/><Button Content="Применить" Width="86" Click="ApplyInspector_Click"/></StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Right: Stream Deck-style action library -->
        <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="2" Background="#1B1D1F" BorderBrush="{StaticResource Border}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="14,12">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="ActionSearchBox" Height="34" VerticalContentAlignment="Center" ToolTip="Поиск действий" TextChanged="ActionSearchBox_TextChanged"/>
                    <Button Grid.Column="1" Content="☷" Margin="6,0,0,0" Padding="0" ToolTip="Каталог действий"/>
                </Grid>
                <TabControl Grid.Row="1" x:Name="ActionTabs">
                    <TabItem Header="Клавиша">
                        <ListBox x:Name="ActionLibraryList" Margin="8" PreviewMouseLeftButtonDown="ActionLibrary_PreviewMouseLeftButtonDown" PreviewMouseMove="ActionLibrary_PreviewMouseMove" MouseDoubleClick="ActionLibrary_DoubleClick">
                            <ListBox.ItemTemplate><DataTemplate><Grid Margin="7,6"><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="{Binding Icon}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
                            <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><Border Background="#202326" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,1" Padding="10,8"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/></Border></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="Информационная"><StackPanel Margin="14"><TextBlock Text="Информационные плитки" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Дата и время" Margin="0,14,0,4"/><TextBlock Text="Статус подключения" Margin="0,4"/><TextBlock Text="Текст / заметка" Margin="0,4"/><TextBlock Text="Системная информация" Margin="0,4"/></StackPanel></TabItem>
                </TabControl>
            </Grid>
        </Border>

        <!-- Profile settings are hidden behind the gear over the workspace. -->
        <primitives:Popup x:Name="ProfileSettingsPopup" PlacementTarget="{Binding ElementName=ProfileSettingsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="610" Background="#202326" BorderBrush="#4A5055" BorderThickness="1" Padding="16" Margin="0,6,0,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/><RowDefinition Height="40"/></Grid.RowDefinitions>
                    <TextBlock Text="Свойства профиля" FontSize="16" FontWeight="SemiBold"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Название" Foreground="{StaticResource Muted}" FontSize="10"/><TextBox x:Name="ProfileName" Height="31" Margin="0,3,0,7"/>
                            <TextBlock Text="Описание" Foreground="{StaticResource Muted}" FontSize="10"/><TextBox x:Name="ProfileDescription" Height="64" Margin="0,3,0,8" AcceptsReturn="True" TextWrapping="Wrap"/>
                            <TextBlock Text="Сетка" FontWeight="SemiBold" FontSize="11"/>
                            <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Столбцы" Foreground="{StaticResource Muted}" FontSize="10"/><TextBox x:Name="ColumnsBox" Height="30"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Строки" Foreground="{StaticResource Muted}" FontSize="10"/><TextBox x:Name="RowsBox" Height="30"/></StackPanel></Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Масштаб рабочего поля" Foreground="{StaticResource Muted}" FontSize="10"/><Slider x:Name="ZoomSlider" Minimum="0.55" Maximum="2.5" Value="1" ValueChanged="ZoomSlider_ValueChanged" Margin="0,5,0,10"/>
                            <TextBlock Text="Отображение и управление" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,6"/>
                            <CheckBox x:Name="ShowNumbers" Content="Показывать номера клавиш" IsChecked="True"/>
                            <CheckBox x:Name="ShowLabels" Content="Показывать подписи" IsChecked="True" Margin="0,5,0,0"/>
                            <CheckBox x:Name="ProfileHaptics" Content="Виброотклик на телефоне" IsChecked="True" Margin="0,5,0,0"/>
                            <CheckBox x:Name="ProfileLongPress" Content="Длинное нажатие" IsChecked="True" Margin="0,5,0,0"/>
                            <TextBlock Text="Ctrl + колесо — масштаб. Плитки можно менять местами перетаскиванием." Foreground="#89BFEF" FontSize="9" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Button Grid.Row="2" Content="Сохранить" HorizontalAlignment="Right" Width="118" Height="31" Click="SaveProfile_Click"/>
                </Grid>
            </Border>
        </primitives:Popup>

        <!-- Connection settings: hidden backing controls; visible UI opens in a separate window. -->
        <primitives:Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=HeaderSettingsButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Width="330" Background="#202326" BorderBrush="#4A5055" BorderThickness="1" Padding="14" Margin="0,6,0,0">
                <StackPanel>
                    <TextBlock Text="Настройки подключения" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Способ подключения" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,12,0,4"/>
                    <ComboBox x:Name="TransportBox" Height="34" SelectionChanged="TransportBox_SelectionChanged">
                        <ComboBoxItem Content="Wi‑Fi" Tag="Wifi"/>
                        <ComboBoxItem Content="Bluetooth LE" Tag="Bluetooth"/>
                    </ComboBox>
                    <TextBlock Text="Wi‑Fi автоматически обнаруживает устройства в одной сети. QR нужен только для первой привязки." Foreground="#86BFEF" FontSize="10" TextWrapping="Wrap" Margin="0,9,0,9"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions>
                        <Button x:Name="DeviceServerButton" Content="Перезапустить связь" Click="ServerButton_Click" Margin="0,0,7,0"/>
                        <Button x:Name="DeviceQrButton" Grid.Column="1" Content="QR-код" Click="ShowQr_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </primitives:Popup>
    </Grid>
</Window>
