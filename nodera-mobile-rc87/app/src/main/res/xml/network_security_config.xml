<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Explicitly installed private CAs may be used for a self-hosted NODERA server.
         This is NOT an SSL-error bypass: all certificates still require validation. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
